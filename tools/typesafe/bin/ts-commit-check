#!/usr/bin/env python3
"""ts-commit-check: TypeSafe Jev commit message & diff validator for AGY & Claude.

Validates:
 1. alignment (Score 0..3): Accuracy of commit message relative to actual code diff.
 2. omissions (Noul): Significant changes omitted from the commit message.
 3. conventional (Noul): Compliance with Conventional Commits syntax (feat:, fix:, docs:, etc.).
 4. leak (Noul + Local): Secrets, API keys, or PII in diff or commit message.
    Local part (local_alarm): an email address, or a keyword value that really looks
    like a secret, in the commit message, the ADDED diff lines or the file list sets
    leak_prob to 1.0, with or without a TypeSafe key. leak_prob >= 0.5
    is a hard block (exit 1), also in fail-open mode. Never a local hit: addresses in
    trailer lines (Co-Authored-By:, Assisted-by:, Signed-off-by:), the no-reply
    addresses in NOREPLY_RE (tool and forge identities, not personal data) and
    addresses on reserved domains (RFC 2606/6761: example.com/.org/.net and *.example,
    *.test, *.invalid, *.localhost, with subdomains; test fixtures); every other
    address, in message or diff, still blocks. This only narrows the local alarm:
    what goes to TypeSafe is masked exactly as before. Removed and context lines raise
    no alarm: a commit that deletes a leaked value must not be blocked for it.
    "Looks like a secret" (the masking toward TypeSafe stays generous, this is only the
    local block): after api_key/token/secret/password/authorization and = := or :,
    a quoted literal of >= 12 characters without whitespace, or an unquoted value of
    >= 20 characters from [A-Za-z0-9_-./+=] with letters and at least 4 digits (a
    plain or dotted identifier has fewer); Bearer/Basic only with a following literal
    of >= 16 such characters. No hit for comparisons (== !=), identifiers and
    expressions (s.Weiter, os.Getenv(...), "Bearer " + tok), empty strings and
    placeholders (<redacted>, xxx, ${...}, REPLACE_ME).

Usage:
  ts-commit-check [COMMIT_RANGE]             # e.g. HEAD~1..HEAD (default)
  ts-commit-check --cached                   # staged changes vs last commit or --msg
  ts-commit-check --msg-file <file>          # git commit-msg hook mode
  ts-commit-check --msg "feat: ..."          # explicit message string
"""
import argparse
import json
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)) + "/..")
import ts_common as tc  # noqa: E402

# Local leak alarm exemptions (the text sent to TypeSafe is masked as before).
TRAILER_LINE_RE = re.compile(r"(?im)^[ \t]*(?:co-authored-by|assisted-by|signed-off-by)[ \t]*:.*$")
NOREPLY_RE = re.compile(
    r"(?i)(?<![\w.+-])(?:noreply@anthropic\.com|noreply@google\.com|noreply@github\.com"
    r"|[\w.+-]+@users\.noreply\.github\.com)(?!\.?[\w-])")
RESERVED_DOMAIN_RE = re.compile(
    r"(?i)^(?:[\w-]+\.)*(?:example\.(?:com|org|net)|[\w-]+\.(?:example|test|invalid|localhost))$")


def _alarm_address(m):
    """'' for an exempt address (no-reply or reserved domain), else the address."""
    addr = m.group(0).rstrip(".-")  # RX_EMAIL may take a sentence-final dot along
    if NOREPLY_RE.fullmatch(addr) or RESERVED_DOMAIN_RE.match(addr.rsplit("@", 1)[1]):
        return ""
    return m.group(0)


_KW_WORDS = r"(?:api[_-]?key|token|secret|passw(?:or)?d|authorization)"
LOCAL_KV_RE = re.compile(
    r"(?i)" + _KW_WORDS + r"[\w.-]*[\"']?[ \t]*(?::=|=(?!=)|:(?!=))[ \t]*"
    r"(?:(?P<q>[\"'])(?P<qv>[^\"'\n]*)(?P=q)|(?P<uv>[A-Za-z0-9_\-./+=]+))")
LOCAL_BEARER_RE = re.compile(r"(?i)\b(?:bearer|basic)[ \t]+(?P<v>[A-Za-z0-9_\-./+=]{16,})")
_PLACEHOLDER_RE = re.compile(r"(?i)^<[^>]*>$|\$\{|x{3,}|replace[_-]?me|os\.getenv")


def _placeholder(v):
    return len(set(v)) <= 1 or bool(_PLACEHOLDER_RE.search(v))


def _value_looks_real(m):
    if m.group("q"):
        v = m.group("qv")
        return len(v) >= 12 and not any(c.isspace() for c in v) and not _placeholder(v)
    v = m.group("uv")
    return (len(v) >= 20 and any(c.isalpha() for c in v)
            and sum(c.isdigit() for c in v) >= 4 and not _placeholder(v))


def local_alarm(text):
    """True if text (already through alarm_view) holds an email address or a keyword
    value / Bearer literal that really looks like a secret."""
    if tc.RX_EMAIL.search(text):
        return True
    if any(not _placeholder(m.group("v")) for m in LOCAL_BEARER_RE.finditer(text)):
        return True
    return any(_value_looks_real(m) for m in LOCAL_KV_RE.finditer(text))


def alarm_view(text):
    """Text as the local leak alarm sees it: trailer-line addresses, no-reply
    addresses and reserved-domain addresses removed, everything else unchanged."""
    text = TRAILER_LINE_RE.sub(lambda m: tc.RX_EMAIL.sub("", m.group(0)), text)
    return tc.RX_EMAIL.sub(_alarm_address, text)


QUESTIONS = {
    "alignment": {
        "type": "score",
        "instructions": (
            "How accurately and truthfully does the commit message describe the actual changes in the diff?\n"
            "Level 0: Complete mismatch, hallucination, or wrong scope.\n"
            "Level 1: Partly misleading, vague, or claims things not in the diff.\n"
            "Level 2: Accurate, consistent, and correctly reflects the changes.\n"
            "Level 3: Exceptionally precise, clear, and perfectly aligned."
        ),
        "criteria": [
            "Level 0: hallucination, total mismatch, or completely wrong",
            "Level 1: vague, partly misleading, or unverified claims",
            "Level 2: accurate and consistent with the diff",
            "Level 3: exceptionally precise and perfectly aligned"
        ]
    },
    "omissions": {
        "type": "noul",
        "instructions": "Are there significant functional changes, modified packages, or added logic in the diff that are completely unmentioned in the commit message?"
    },
    "conventional": {
        "type": "noul",
        "instructions": "Does the first line of the commit message strictly follow Conventional Commits formatting, e.g. type(scope): description or type: description (feat, fix, docs, refactor, test, chore, perf, build, ci)?"
    },
    "leak": {
        "type": "noul",
        "instructions": "Does either the commit message or the code diff contain real secrets, API keys, passwords, private tokens, or real personal identifiable data (PII)?"
    }
}


def run_cmd(cmd, cwd=None):
    try:
        r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=10)
        return r.stdout.strip()
    except Exception:
        return ""


def get_diff_and_msg(args, cwd=None):
    commit_msg = ""
    diff_text = ""
    stat_text = ""

    if args.msg_file:
        try:
            with open(args.msg_file, "r", encoding="utf-8") as f:
                commit_msg = f.read().strip()
        except Exception as e:
            return None, None, None, f"Could not read msg file: {e}"
        diff_text = run_cmd(["git", "diff", "--cached"], cwd=cwd)
        stat_text = run_cmd(["git", "diff", "--cached", "--stat"], cwd=cwd)
    elif args.cached:
        if args.msg:
            commit_msg = args.msg.strip()
        else:
            commit_msg = run_cmd(["git", "log", "-1", "--pretty=%B"], cwd=cwd)
        diff_text = run_cmd(["git", "diff", "--cached"], cwd=cwd)
        stat_text = run_cmd(["git", "diff", "--cached", "--stat"], cwd=cwd)
    else:
        rng = args.range or "HEAD~1..HEAD"
        if args.msg:
            commit_msg = args.msg.strip()
        else:
            commit_msg = run_cmd(["git", "log", "-1", "--pretty=%B", rng.split("..")[-1]], cwd=cwd)
        diff_text = run_cmd(["git", "diff", rng], cwd=cwd)
        stat_text = run_cmd(["git", "diff", "--stat", rng], cwd=cwd)

    return commit_msg, diff_text, stat_text, None


def check_commit(commit_msg, diff_text, stat_text):
    if not commit_msg:
        return {"status": "error", "message": "No commit message provided"}
    if not diff_text:
        return {"status": "ok", "empty_diff": True, "message": "Diff is empty (nothing changed)"}

    # Masking before anything leaves the machine (privacy: only masked text goes to TypeSafe).
    # Mask first, then cut: a cut first could split a token or an address so that the
    # masking no longer recognises the remaining fragment.
    masked_msg, h1 = tc.mask_detail(commit_msg)
    masked_diff, h2 = tc.mask_detail(diff_text)
    masked_stat, h3 = tc.mask_detail(stat_text)
    hits = tc.add_counts(h1, h2, h3)
    added = "\n".join(line[1:] for line in diff_text.splitlines()
                      if line.startswith("+") and not line.startswith("+++"))
    if len(masked_diff) > 12000:
        masked_diff = masked_diff[:12000] + "\n... [diff truncated for check]"
    # Local part of the leak check (see docstring): addresses and real-looking keyword
    # values in message, added lines and file list; exemptions in alarm_view and
    # local_alarm. Opaque strings (hashes, long identifiers) are masked, no alarm.
    local_leak = any(local_alarm(alarm_view(t)) for t in (commit_msg, added, stat_text))

    state = {
        "commit_message": masked_msg,
        "files_changed": masked_stat,
        "diff": masked_diff
    }

    answers = tc.post(state, QUESTIONS)
    if not answers:
        return {
            "status": "fail_open",
            "message": "TypeSafe API unreachable or key missing (fail-open)",
            "leak_prob": 1.0 if local_leak else None,
            "masked_detail": hits
        }

    align = tc.score_level(answers, "alignment")
    align_lvl, align_conf = align if align else (2, 0.5)

    omissions = tc.noul(answers, "omissions") or 0.0
    conventional = tc.noul(answers, "conventional") or 0.0
    leak_prob = tc.noul(answers, "leak") or 0.0
    if local_leak:
        leak_prob = 1.0

    align_label = [
        "Unzureichend / Halluzination",
        "Teilweise passend / vage",
        "Präzise und konsistent",
        "Exzellent und vollständig"
    ][align_lvl]

    return {
        "status": "ok",
        "alignment_level": align_lvl,
        "alignment_confidence": align_conf,
        "alignment_label": align_label,
        "omissions_prob": omissions,
        "conventional_prob": conventional,
        "leak_prob": leak_prob,
        "masked_detail": hits,
        "raw_answers": answers
    }


def main():
    parser = argparse.ArgumentParser(description="TypeSafe Commit-Message & Diff Checker (Jev)")
    parser.add_argument("range", nargs="?", default="HEAD~1..HEAD", help="Commit range, e.g. HEAD~1..HEAD")
    parser.add_argument("--cached", action="store_true", help="Check staged changes")
    parser.add_argument("--msg-file", help="Path to commit message file (git commit-msg hook mode)")
    parser.add_argument("--msg", help="Explicit commit message string")
    parser.add_argument("--strict", action="store_true", help="Exit 1 on low alignment or omissions")
    parser.add_argument("--cwd", default=".", help="Repository directory")
    parser.add_argument("--json", action="store_true", help="Output raw JSON")
    args = parser.parse_args()

    commit_msg, diff_text, stat_text, err = get_diff_and_msg(args, cwd=args.cwd)
    if err:
        if args.json:
            print(json.dumps({"status": "error", "message": err}))
        else:
            print(f"Fehler: {err}")
        sys.exit(1)

    res = check_commit(commit_msg, diff_text, stat_text)

    if args.json:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return

    if res["status"] == "fail_open":
        print(f"Hinweis: {res['message']}")
        if res["leak_prob"] is not None:
            print(f" • Lokale Maskierung: {tc.format_counts(res['masked_detail'])}")
            print("❌ ABBRUCH: Schlüsselwort-Secret oder E-Mail-Adresse im Diff oder in der Nachricht "
                  "(lokal erkannt, ohne TypeSafe). Bitte manuell prüfen.")
            sys.exit(1)
        sys.exit(0)

    if res.get("empty_diff"):
        print("Hinweis: Diff ist leer (keine Änderungen).")
        sys.exit(0)

    m = res["masked_detail"]
    print("═══════════════════════════════════════════════════════════════")
    print(" TypeSafe Commit-Prüfung (Jev)")
    print("═══════════════════════════════════════════════════════════════")
    print(f" • Übereinstimmung   : Stufe {res['alignment_level']}/3 – {res['alignment_label']} (Konfidenz: {res['alignment_confidence']:.2f})")
    print(f" • Auslassungen      : Wahrscheinlichkeit {res['omissions_prob']:.2f}")
    print(f" • Conventional Style: Wahrscheinlichkeit {res['conventional_prob']:.2f}")
    print(f" • Secret/PII Leak   : Wahrscheinlichkeit {res['leak_prob']:.2f}"
          f" (lokal maskiert: {tc.format_counts(m)})")
    print("═══════════════════════════════════════════════════════════════")

    # Hard blocker: secret leak stops execution
    if res["leak_prob"] >= 0.5:
        print("❌ ABBRUCH: Verdacht auf Secret- oder PII-Leak! Bitte manuell prüfen.")
        sys.exit(1)

    if args.strict:
        if res["alignment_level"] < 2 or res["omissions_prob"] > 0.6:
            print("❌ ABBRUCH (strict): Commit-Nachricht weicht wesentlich vom Diff ab oder lässt Änderungen aus.")
            sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
