{
  "permissions": {
    "allow": [
      "command(git status)",
      "command(git log)",
      "command(git diff)",
      "command(git show)",
      "command(git fetch)",
      "command(git add)",
      "command(git commit)",
      "command(git switch)",
      "command(git checkout)",
      "command(git branch)",
      "command(git worktree add)",
      "command(git worktree list)",
      "command(git rebase)",
      "command(git push)",
      "command(git rev-parse)",
      "command(git merge-base)",
      "command(go build)",
      "command(go test)",
      "command(go vet)",
      "command(go fmt)",
      "command(go run)",
      "command(go mod tidy)",
      "command(gh pr create)",
      "command(gh pr view)",
      "command(gh pr list)",
      "command(gh pr diff)",
      "command(gh pr checks)",
      "command(gh run list)",
      "command(gh run view)",
      "command(rg)",
      "command(grep)",
      "command(ls)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(wc)",
      "command(find)",
      "command(diff)",
      "command(sort)",
      "command(jq)",
      "command(ts-route)",
      "command(ts-pr-triage)",
      "command(systemctl --user daemon-reload)",
      "command(systemctl --user enable --now imprint-oberflaeche.service)",
      "command(systemctl --user restart imprint-oberflaeche.service)",
      "command(systemctl --user is-active imprint-oberflaeche.service)",
      "command(systemctl --user status imprint-oberflaeche.service)",
      "command(systemd-analyze --user verify ${HOME}/.config/systemd/user/imprint-oberflaeche.service)",
      "command(mkdir -p ${HOME}/.config/systemd/user)",
      "read_file(${HOME}/orchestration.md)",
      "write_file(${PROJEKTE}/imprint-wt/.*)",
      "write_file(${PROJEKTE}/imprint-core-wt/.*)",
      "write_file(${PROJEKTE}/typesafe-dev-wt/.*)",
      "write_file(${HOME}/.config/systemd/user/imprint-oberflaeche.service)",
      "read_file(${PROJEKTE}/imprint/.*)",
      "read_file(${PROJEKTE}/imprint-wt/.*)",
      "read_file(${PROJEKTE}/imprint-core/.*)",
      "read_file(${PROJEKTE}/imprint-core-wt/.*)",
      "read_file(${PROJEKTE}/typesafe-dev/.*)",
      "read_file(${PROJEKTE}/typesafe-dev-wt/.*)"
    ],
    "deny": [
      "command(git push --force)",
      "command(git push -f)",
      "command(git push --force-with-lease)",
      "command(git push --mirror)",
      "command(git push -uf)",
      "command(git push --delete)",
      "command(git push -d)",
      "command(find -exec)",
      "command(find -delete)",
      "command(find -execdir)",
      "command(gh pr merge)",
      "command(rm)",
      "command(curl)",
      "command(wget)",
      "command(sudo)",
      "command(flock)",
      "command(bash -c)",
      "command(sh -c)",
      "command(python)",
      "command(npm)",
      "command(brew)",
      "command(rpm-ostree)",
      "command(jules)",
      "command(imprint-dev setup --apply)",
      "command(go run ./tools/imprint-dev setup --apply)",
      "command(go run tools/imprint-dev setup --apply)",
      "write_file(${HOME}/.gemini/antigravity-cli/settings.json)",
      "write_file(${HOME}/.claude/settings.json)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${HOME}/.gemini/antigravity-cli/statusline.py"
  },
  "trustedWorkspaces": [
    "${TRUSTED_WORKSPACE}"
  ]
}
