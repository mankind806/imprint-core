'
# --- the identities git shows ------------------------------------------------
# git log re-encodes what it prints into i18n.logOutputEncoding, or into
# i18n.commitEncoding when that is unset (measured with git 2.55.0,
# 2026-10-01). A declared name outside ASCII, printed in Latin-1, would no
# longer equal the UTF-8 one in the declared list, so git is asked for UTF-8,
# which is what git config holds. Check 1 reads these lines, and prepare
# below what git shows of the commit it reads.
git log --no-walk=unsorted --stdin --no-show-signature --no-color --encoding=UTF-8 \
  --format='%H A %an <%ae>%n%H C %cn <%ce>' <"$work/commits" >"$work/ids" \
  || refuse "git log failed reading the identities of the new commits."
# Two lines a commit, and nothing else: with log.showSignature on, git log
# prints what verifying a signature says in between, unless told not to.
n_idlines="$(wc -l <"$work/ids" | tr -d ' ')"
[ "$n_idlines" = $((2 * n_commits)) ] || refuse \
  "git log listed ${n_idlines:-no} identity line(s) for $n_commits new commit(s), not two each."

# ascii_of TEXT - TEXT with every byte outside printable ASCII taken out. In
# an encoding outside the list prepare reads in full, a conversion can make a
# line git shows that the object as stored does not hold - UTF-7 or EBCDIC
# did - and its identity differs from the stored one in ASCII. Shift_JIS,
# Big5 and GBK keep ASCII-range bytes inside a character, so the comparison
# is not made for the encodings on the list, whose conversion makes no line.
ascii_of() { printf '%s\n' "$1" | LC_ALL=C sed 's/[^ -~]//g'; }

# Each object is read whole or the push stops here: a commit whose object
# could not be read is one whose header and message nothing has checked.
# committext and commitloc are parallel, as added and addedloc are below, and
# rawcommits lists "oid N U" for each commit read as converted as well, U
# being 1 when its encoding is not one prepare reads in full, 2 when it is but
# the object holds a NUL, else 0, and raw.N
# holding its object.
for f in committext commitloc convtext convloc mttaggers rawcommits; do
  true >"$work/$f" || refuse "$cannot_write"
done
n_obj=0; n_raw=0; n_lines=0; n_conv=0; n_mt=0
while read -r o_oid; do
  n_obj=$((n_obj + 1))
  # ids holds two lines a commit, in the order of commits.
  o_a=''; o_c=''
  { IFS= read -r o_a && IFS= read -r o_c; } <&3 || refuse "could not read back the identities of commit $o_oid."
  case "$o_a" in "$o_oid A "*) o_a="${o_a#"$o_oid A "}" ;; *) refuse "the identities git listed are out of step at commit $o_oid." ;; esac
  case "$o_c" in "$o_oid C "*) o_c="${o_c#"$o_oid C "}" ;; *) refuse "the identities git listed are out of step at commit $o_oid." ;; esac
  git cat-file commit "$o_oid" >"$work/raw.tmp" 2>/dev/null </dev/null \
    || refuse "could not read commit $o_oid as stored."
  tr '\000' '\001' <"$work/raw.tmp" >"$work/raw.t" \
    || refuse "could not prepare commit $o_oid for reading as stored."
  # tr maps byte for byte, so the copy has to be as long as the object.
  [ "$(wc -c <"$work/raw.tmp" | tr -d ' ')" = "$(wc -c <"$work/raw.t" | tr -d ' ')" ] \
    || refuse "could not copy commit $o_oid whole."
  # The copy differs from the object only where a NUL was.
  cmp -s "$work/raw.tmp" "$work/raw.t" </dev/null; o_nul=$?
  case "$o_nul" in 0) o_nul='' ;; 1) o_nul=1 ;; *) refuse "cmp could not compare commit $o_oid with its copy." ;; esac
  true >"$work/objcnt" || refuse "$cannot_write"
  IMPRINT_COMMIT="$o_oid" IMPRINT_COMMITLOC="$work/commitloc" IMPRINT_MTTAGGERS="$work/mttaggers" \
    IMPRINT_ALLOWED="$work/allowed" IMPRINT_COMMITTERS="$work/committers" \
    IMPRINT_AUTHOR_SHOWN="$o_a" IMPRINT_COMMITTER_SHOWN="$o_c" IMPRINT_RAWTAGGERS='' IMPRINT_UNREAD='' \
    IMPRINT_ENCLINES='' IMPRINT_HASNUL="$o_nul" \
    IMPRINT_OBJCNT="$work/objcnt" LC_ALL=C awk "$prepare" "$work/raw.t" "$work/raw.t" \
    >>"$work/committext" </dev/null || refuse "awk could not read commit $o_oid."
  o_k=''; o_conv=''; o_m=''; o_u=''; o_e=''
  { read -r o_k && read -r o_conv && read -r o_m && read -r o_u && read -r o_e; } <"$work/objcnt" || o_k=''
  case "$o_k:$o_conv:$o_m:$o_u:$o_e" in
    *[!0-9:]* | :* | *::* | *:) refuse "awk reported no count of what it read from commit $o_oid." ;;
  esac
  n_lines=$((n_lines + o_k)); n_mt=$((n_mt + o_m))
  if [ "$o_u" != 0 ]; then
    o_enc="$(LC_ALL=C sed -n -e '/^$/q' -e 's/^encoding //p' "$work/raw.t" | LC_ALL=C sed -n 1p)"
    if [ "$o_u" = 1 ]; then
      note findings 'unread encoding: commit %s names the encoding "%s", which this hook does not read in full\n' "$o_oid" "$o_enc"
    else
      # git stops at a NUL in what it converts, and a Latin-1 place after it
      # matches nothing as stored.
      note findings 'unread encoding: commit %s names the encoding "%s" and holds a NUL byte, where git stops converting it\n' "$o_oid" "$o_enc"
    fi
  fi
  if [ "$o_conv" = 1 ]; then
    n_raw=$((n_raw + 1))
    mv "$work/raw.t" "$work/raw.$n_raw" || refuse "could not keep commit $o_oid for reading as converted."
    note rawcommits '%s %s %s\n' "$o_oid" "$n_raw" "$o_u"
    r_u="$o_u"; r_e="$o_e"
    case "$r_u" in 1) r_uf=1 ;; *) r_uf='' ;; esac
    # The whole commit as git log converts it, header and message: --pretty=raw
    # prints every header line, a converted one as git reads it. --no-color,
    # since color.ui=always or git -p in a terminal colours the commit line.
    git log -1 --no-show-signature --no-notes --no-decorate --no-color --encoding=UTF-8 --pretty=raw "$o_oid" \
      >"$work/conv.tmp" </dev/null || refuse "git log failed reading commit $o_oid as converted."
    o_first=''
    { IFS= read -r o_first; } <"$work/conv.tmp" || o_first=''
    [ "$o_first" = "commit $o_oid" ] || refuse "git log printed no commit $o_oid to read as converted."
    true >"$work/objcnt" || refuse "$cannot_write"
    IMPRINT_COMMIT="$o_oid" IMPRINT_COMMITLOC="$work/convloc" IMPRINT_MTTAGGERS="$work/mttaggers" \
      IMPRINT_ALLOWED="$work/allowed" IMPRINT_COMMITTERS="$work/committers" \
      IMPRINT_AUTHOR_SHOWN="$o_a" IMPRINT_COMMITTER_SHOWN="$o_c" IMPRINT_RAWTAGGERS="$work/mttaggers" \
      IMPRINT_UNREAD="$r_uf" IMPRINT_ENCLINES="$r_e" IMPRINT_HASNUL='' \
      IMPRINT_OBJCNT="$work/objcnt" LC_ALL=C awk "$prepare" "$work/conv.tmp" "$work/conv.tmp" \
      >>"$work/convtext" </dev/null || refuse "awk could not read commit $o_oid as converted."
    o_k=''; o_conv=''; o_m=''; o_u=''; o_e=''
    { read -r o_k && read -r o_conv && read -r o_m && read -r o_u && read -r o_e; } <"$work/objcnt" || o_k=''
    case "$o_k:$o_conv:$o_m:$o_u:$o_e" in
      *[!0-9:]* | :* | *::* | *:) refuse "awk reported no count of what it read from commit $o_oid as converted." ;;
    esac
    n_conv=$((n_conv + o_k)); n_mt=$((n_mt + o_m))
    # git prints a commit it could not convert in full - one byte the
    # encoding leaves undefined is enough - as stored, encoding line and all,
    # and a Latin-1 place then matches neither reading (measured with git
    # 2.55.0, 2026-10-02). What it converts loses its first encoding line, so
    # one left for each the object holds is a commit git did not convert.
    if [ "$o_conv" = 1 ] && [ "$r_u" = 0 ]; then
      o_enc="$(LC_ALL=C sed -n -e '/^$/q' -e 's/^encoding //p' "$work/raw.$n_raw" | LC_ALL=C sed -n 1p)"
      note findings 'unread encoding: commit %s names the encoding "%s", which git could not convert in full\n' "$o_oid" "$o_enc"
    fi
  fi
done <"$work/commits" 3<"$work/ids" || refuse "could not read back the new commits."
[ "$n_obj" = "$n_commits" ] || refuse "read back $n_obj of $n_commits new commit(s)."
# A line awk could not write down - a full disk, say - would go unmatched.
for f in committext:"$n_lines" commitloc:"$n_lines" convtext:"$n_conv" convloc:"$n_conv" mttaggers:"$n_mt"; do
  n_f="$(wc -l <"$work/${f%%:*}" | tr -d ' ')"
  [ "$n_f" = "${f#*:}" ] || refuse \
    "wrote down ${n_f:-none} of ${f#*:} line(s) of the new commits' objects in ${f%%:*}."
done

# --- check 1: every author and committer is a declared identity --------------
# The declared identities, and the committers it accepts, are written down
# above.

# An author or committer of a commit read as converted as well (above) is
# declared when either reading of it is - the stored one, for an encoding
# outside the list prepare reads in full, only when the two differ in nothing
# but characters outside ASCII (see ascii_of).
true >"$work/undeclared" || refuse "$cannot_write"
while IFS= read -r line; do
  i_oid="${line%% *}"; line="${line#* }"
  role="${line%% *}"; id="${line#? }"
  [ -n "$id" ] || continue
  if [ "$role" = C ]; then list="$work/committers"; key=committer; else list="$work/allowed"; key=author; fi
  grep -Fxq -- "$id" "$list" && continue
  r_line="$(sed -n "s/^$i_oid //p" "$work/rawcommits")"
  r_n="${r_line% *}"; r_u="${r_line#* }"
  if [ -n "$r_line" ]; then
    # git takes the last of several author or committer lines, so the stored
    # reading vouches only for a header that has exactly one. In an encoding
    # outside the list prepare reads in full, a conversion can make a line of
    # its own, and the stored reading vouches only for an identity git shows
    # that differs from it in nothing but characters outside ASCII.
    r_hdr="$(LC_ALL=C sed -n -e '/^$/q' -e "/^$key /p" "$work/raw.$r_n")"
    case "$r_hdr" in
      '' | *"$nl"*) ;;
      *)
        r_id="$(printf '%s\n' "$r_hdr" | LC_ALL=C sed -n "s/^$key \\(.*>\\).*\$/\\1/p")"
        [ -n "$r_id" ] && LC_ALL=C grep -Fxq -- "$r_id" "$list" \
          && { [ "$r_u" != 1 ] || [ "$(ascii_of "$r_id")" = "$(ascii_of "$id")" ]; } && continue
        ;;
    esac
  fi
  note undeclared '%s\n' "$id"
done <"$work/ids" || refuse "could not read back the identities of the new commits."
sort -u -o "$work/undeclared" "$work/undeclared" || refuse "could not sort the undeclared identities."
while IFS= read -r id; do
  note findings 'undeclared identity: %s\n' "$id"
done <"$work/undeclared" || refuse "could not read back the undeclared identities."
undeclared="$(wc -l <"$work/undeclared" | tr -d ' ')"
n_ids="$(sed 's/^[^ ]* . //' "$work/ids" | sort -u | wc -l | tr -d ' ')"

# The tagger of a tag a new merge carries in its mergetag header, read above,
# is held to the declared identities as the tag check holds a tagger: the
# web-flow identity is not one, and a tagger line that does not end its
# identity in "<...>" is a check that could not run.
n_read=0; n_mt_undeclared=0
while IFS= read -r m_line; do
  n_read=$((n_read + 1))
  # Split at the first TAB by hand: read would trim one that starts the
  # identity, and the identity is compared as written.
  m_oid="${m_line%%"$tab"*}"; m_id="${m_line#*"$tab"}"
  if [ -z "$m_id" ]; then
    note errors 'could not read the tagger of the tag commit %s merges as "Name <address>"\n' "$m_oid"
    continue
  fi
  LC_ALL=C grep -Fxq -- "$m_id" "$work/allowed"; rc=$?
  if [ "$rc" -eq 1 ]; then
    note findings 'undeclared identity: %s, tagger of the tag commit %s merges\n' "$m_id" "$m_oid"
    n_mt_undeclared=$((n_mt_undeclared + 1))
  elif [ "$rc" -gt 1 ]; then
    note errors 'grep could not read the declared identities for the tagger of the tag commit %s merges\n' "$m_oid"
  fi
done <"$work/mttaggers" || refuse "could not read back the taggers of merged tags."
[ "$n_read" = "$n_mt" ] || refuse "read back $n_read of $n_mt tagger(s) of merged tags."
if [ "$n_mt" -gt 0 ]; then
  note ran 'declared identity - %s identity/identities over %s new commit(s), %s undeclared; %s tagger(s) of merged tags, %s undeclared\n' \
    "$n_ids" "$n_commits" "$undeclared" "$n_mt" "$n_mt_undeclared"
else
  note ran 'declared identity - %s identity/identities over %s new commit(s), %s undeclared\n' \
    "$n_ids" "$n_commits" "$undeclared"
fi

# --- check 2: tracked content, the lines the new commits add -----------------
# Every new commit, not just the tip: a push publishes them all, and a line
# removed in a later commit stays reachable by its hash for anyone who clones.
# The added lines are enough, because every line of a new commit's tree was
# either added by some new commit or is already on the remote.
#
# A merge adds a line only when the line is new against every parent - a line
# from either parent was checked at that parent or is already published. Each
# commit is therefore diffed once per parent (a root commit once, against
# nothing), and a line counts as added only when every one of those diffs adds
# it at the same place: same path, same line number in the commit's own tree,
# same content. All the diffs number lines in that one tree, so the match is
# exact. A combined diff (-c) is not used, because it ignores --text: a file
# that holds a NUL byte in the merge or in any parent, or that .gitattributes
# marks binary, comes out as "Binary files differ" with no line in it (measured
# with git 2.55.0, 2026-10-01). On a plain diff --text is not decoration either
# - without it the same files would read as nothing, which looks exactly like a
# clean diff - and should git print "Binary files" anyway, that is an error.
#
# The awks only sort lines; the shapes are matched by grep below, under your
# own locale and under C (grep_both): a file is stored as it was written, in
# whatever encoding that was. classify turns
# one diff into one record per added line, "commit:path:line<TAB>content" -
# git quotes a path that holds a control character, so the location has no raw
# TAB. Inside a hunk every line starts with +, -, a space or a backslash; any
# other line means the diff is not in the shape these line numbers assume, and
# the commit is not read rather than read wrong. intersect keeps the records
# every parent's diff has and appends them to two parallel files: line N of
# addedloc says where line N of added comes from (commit:path:line), and added
# holds the bare content. Both awks report how many records they wrote, and a
# file that holds fewer - a write that failed without awk saying so - is an
# error, not a shorter list.
classify='
BEGIN { st = 0; c = ENVIRON["IMPRINT_COMMIT"]; errf = ENVIRON["IMPRINT_AWKERR"]; k = 0 }
/^Binary files / {
  p = substr($0, 14); sub(/ differ$/, "", p)
  i = index(p, " and "); if (i) p = substr(p, i + 5)
  if (substr(p, 1, 2) == "b/") p = substr(p, 3)
  print "could not read " p " as text" > errf
  exit 4
}
/^diff / { st = 1; path = ""; next }
st == 1 && /^\+\+\+ / {
  path = substr($0, 5)
  if (substr(path, 1, 2) == "b/") path = substr(path, 3)
  if (substr(path, length(path), 1) == "\t") path = substr(path, 1, length(path) - 1)
  next
}
/^@/ {
  if (substr($0, 1, 3) != "@@ ") exit 3
  split($0, f, " ")
  ln = f[3]
  if (substr(ln, 1, 1) != "+") exit 3
  ln = substr(ln, 2); sub(/,.*/, "", ln)
  if (ln !~ /^[0-9]+$/) exit 3
  ln = ln + 0
  st = 2
  next
}
st == 2 {
  ch = substr($0, 1, 1)
  if (ch == "+") { print c ":" path ":" ln "\t" substr($0, 2); ln++; k++ }
  else if (ch == " ") ln++
  else if (ch != "-" && ch != "\\") exit 3
}
END { print k > ENVIRON["IMPRINT_AWKCNT"] }
'
intersect='
BEGIN { n = ARGC - 1; loc = ENVIRON["IMPRINT_ADDEDLOC"]; add = ENVIRON["IMPRINT_ADDED"]; fi = 0; m = 0 }
FNR == 1 { fi++ }
{
  if ((fi, $0) in seen) next
  seen[fi, $0] = 1
  cnt[$0]++
  if (fi == 1) order[++m] = $0
}
END {
  k = 0
  for (i = 1; i <= m; i++) {
    r = order[i]
    if (cnt[r] != n) continue
    t = index(r, "\t")
    if (t < 2) exit 3
    print substr(r, 1, t - 1) >> loc
    print substr(r, t + 1) >> add
    k++
  }
  print k
}
'
# join puts a grep hit back where it came from: "N:content" becomes
# "label: location:content", line N of IMPRINT_LOC being the location - for an
# added line "commit:path:line", the form git grep prints.
join='
BEGIN {
  f = ENVIRON["IMPRINT_LOC"]; name = ENVIRON["IMPRINT_SHAPE"]; n = 0
  while ((r = (getline l < f)) > 0) loc[++n] = l
  if (r < 0) exit 2
}
{
  i = index($0, ":")
  k = substr($0, 1, i - 1)
  if (i < 2 || !(k in loc)) exit 3
  print name ": " loc[k] ":" substr($0, i + 1)
}
'

# read_added BASE COMMIT OUT - the records of the lines COMMIT adds against
# BASE, or against nothing when BASE is empty, into OUT. Any step that fails
# goes to the errors file, and the caller drops the commit's records.
read_added() {
  ra_base="$1"; ra_commit="$2"; ra_out="$3"
  if [ -n "$ra_base" ]; then
    ra_against="$ra_base"
    git -c diff.suppressBlankEmpty=false \
      diff-tree --no-commit-id -r -p -M -U0 --text --no-ext-diff --no-textconv --no-color \
      "$ra_base" "$ra_commit" >"$work/diff" 2>"$work/differr" </dev/null
  else
    ra_against="nothing (a root commit)"
    git -c diff.suppressBlankEmpty=false \
      diff-tree --no-commit-id -r -p -M -U0 --text --no-ext-diff --no-textconv --no-color \
      --root "$ra_commit" >"$work/diff" 2>"$work/differr" </dev/null
  fi || {
    note errors 'git diff-tree could not read %s against %s: %s\n' \
      "$ra_commit" "$ra_against" "$(cat "$work/differr")"
    return 1
  }
  # A NUL would end an awk record early in some awks; it never matches a shape.
  tr '\000' '\001' <"$work/diff" >"$work/diff.t" || {
    note errors 'tr could not prepare the diff of %s against %s\n' "$ra_commit" "$ra_against"
    return 1
  }
  true >"$work/awkerr" && true >"$work/awkcnt" || refuse "$cannot_write"
  IMPRINT_COMMIT="$ra_commit" IMPRINT_AWKERR="$work/awkerr" IMPRINT_AWKCNT="$work/awkcnt" \
    LC_ALL=C awk "$classify" <"$work/diff.t" >"$ra_out" || {
    note errors 'awk could not sort the diff of %s against %s into added lines: %s\n' \
      "$ra_commit" "$ra_against" "$(cat "$work/awkerr")"
    return 1
  }
  ra_k="$(cat "$work/awkcnt")"; ra_n="$(wc -l <"$ra_out" | tr -d ' ')"
  [ -n "$ra_k" ] && [ "$ra_k" = "$ra_n" ] || {
    note errors 'wrote down %s of %s line(s) %s adds against %s\n' \
      "$ra_n" "${ra_k:-an unknown number of}" "$ra_commit" "$ra_against"
    return 1
  }
}

# intersect_added N - appends to added and addedloc the records that all of
# rec.1 .. rec.N hold, and prints how many.
intersect_added() {
  ia_n="$1"; ia_i=1
  set --
  while [ "$ia_i" -le "$ia_n" ]; do set -- "$@" "$work/rec.$ia_i"; ia_i=$((ia_i + 1)); done
  IMPRINT_ADDED="$work/added" IMPRINT_ADDEDLOC="$work/addedloc" \
    LC_ALL=C awk "$intersect" "$@" </dev/null
}

true >"$work/added" && true >"$work/addedloc" || refuse "$cannot_write"
n_added=0
# One line per new commit: the commit, then its parents.
if git rev-list --no-walk=unsorted --parents --stdin <"$work/commits" >"$work/parents" 2>"$work/rlerr"; then
  n_parents_lines="$(wc -l <"$work/parents" | tr -d ' ')"
  [ "$n_parents_lines" = "$n_commits" ] || note errors \
    'git rev-list listed parents for %s of %s new commit(s)\n' "$n_parents_lines" "$n_commits"
else
  note errors 'git rev-list could not read the parents of the new commits: %s\n' "$(cat "$work/rlerr")"
  true >"$work/parents" || refuse "$cannot_write"
fi
while read -r commit parents; do
  [ -n "$commit" ] || continue
  n=0; ok=yes
  if [ -z "$parents" ]; then
    n=1
    read_added '' "$commit" "$work/rec.1" || ok=no
  else
    for parent in $parents; do
      n=$((n + 1))
      read_added "$parent" "$commit" "$work/rec.$n" || { ok=no; break; }
    done
  fi
  [ "$ok" = yes ] || continue
  if k="$(intersect_added "$n")"; then
    case "$k" in
      '' | *[!0-9]*) note errors 'awk reported no count of the added lines of %s\n' "$commit" ;;
      *) n_added=$((n_added + k)) ;;
    esac
  else
    note errors 'awk could not match the added lines of %s across its %s parent(s)\n' "$commit" "$n"
  fi
done <"$work/parents" || refuse "could not read back the parents of the new commits."
for f in added addedloc; do
  n_f="$(wc -l <"$work/$f" | tr -d ' ')"
  [ "$n_f" = "$n_added" ] || note errors \
    'wrote down %s of %s added line(s) in %s\n' "${n_f:-none}" "$n_added" "$f"
done
# place_hits LABEL LOC - appends the hits grep_both left in hits to findings,
# each put back where LOC says it came from, as "LABEL: location:content".
# Every hit is one finding, so join has to place as many lines as hits holds:
# an awk that lost a write without saying so is an error. They go to a file
# of their own first and then onto findings in one write, which refuses the
# push when it fails, as note does; findings itself is never read back here.
place_hits() {
  ph_label="$1"; ph_loc="$2"
  true >"$work/placed" || refuse "$cannot_write"
  if IMPRINT_SHAPE="$ph_label" IMPRINT_LOC="$ph_loc" \
    LC_ALL=C awk "$join" <"$work/hits" >"$work/placed"; then
    n_hits="$(wc -l <"$work/hits" | tr -d ' ')"
    n_placed="$(wc -l <"$work/placed" | tr -d ' ')"
    if [ -n "$n_hits" ] && [ "$n_placed" = "$n_hits" ]; then
      cat "$work/placed" >>"$work/findings" || refuse "$cannot_write"
    else
      note errors 'placed %s of %s %s hit(s)\n' "${n_placed:-?}" "${n_hits:-?}" "$ph_label"
    fi
  else
    note errors 'awk could not place the %s hits\n' "$ph_label"
  fi
}

n_done=0
while IFS="$tab" read -r name pattern; do
  if grep_both "$name" "$pattern" "$work/added" "the added lines"; then
    place_hits "$name" "$work/addedloc"
  fi
  n_done=$((n_done + 1))
done <"$work/shapes"
[ "$n_done" = "$n_shapes" ] || note errors \
  'ran %s of %s shape(s) over the added lines\n' "$n_done" "$n_shapes"
note ran 'tracked content - %s shape(s) over the lines %s new commit(s) add\n' \
  "$n_shapes" "$n_commits"

# --- check 3: commit objects -------------------------------------------------
# A message is as public as a blob, and trailers are where addresses ride in; a
# header line is published as much. Each new commit's object was read above, as
# stored, but for the identities check 1 reads, a merged tag's tagger included,
# and a signature's base64 lines. A commit whose header names an encoding other
# than UTF-8 was read as git log converts it, too, header and message: in
# Latin-1, a place that starts with an umlaut matches the pattern neither under
# a UTF-8 locale nor under C, and in UTF-7 a header line read as stored shows no
# shape that git shows in it. The shapes are matched line by line, as everywhere
# in this hook.
n_done=0
while IFS="$tab" read -r name pattern; do
  if grep_both "$name" "$pattern" "$work/committext" "the commit objects"; then
    place_hits "$name in a commit object" "$work/commitloc"
  fi
  if [ "$n_raw" -gt 0 ] \
    && grep_both "$name" "$pattern" "$work/convtext" "the converted commits"; then
    place_hits "$name in a commit converted to UTF-8" "$work/convloc"
  fi
  n_done=$((n_done + 1))
done <"$work/shapes"
[ "$n_done" = "$n_shapes" ] || note errors \
  'ran %s of %s shape(s) over the commit objects\n' "$n_done" "$n_shapes"
note ran 'commit objects - %s shape(s) over %s new commit object(s), all but the identities check 1 reads; %s of them also as converted to UTF-8\n' \
  "$n_shapes" "$n_commits" "$n_raw"

# --- report ------------------------------------------------------------------
report
