#!/bin/sh
#
# imprint - pre-push gate
#
# WHAT IT ENFORCES. One rule has a mechanical half, and this is it: nothing
# leaves this repository except its git identity. The hook refuses a push whose
# commits carry an identity this clone has not declared, and it refuses a push
# whose new commits add a line, or carry a message, that matches a shape that
# personal data takes - phone numbers, bank account numbers and postal
# addresses in the formats the patterns below spell out. An annotated tag is
# held to the same: its tagger has to be a declared identity, and nothing else
# in it - the message above all - may match a shape. A ref that ends in a blob
# or a tree is refused unread.
#
# WHAT IT READS. The new commits, and of their content only the lines they
# add; and every tag object a pushed ref leads to, all of it.
# A commit is new unless the remote's old tip for that ref reaches it, or
# one of this clone's tracking refs for the destination remote does
# (refs/remotes/<remote>/*, only when the push goes to the URL they are fetched
# from, and only while no other remote stores refs under that prefix). Those
# refs are what this clone last fetched, not what the remote holds now: after
# pointing a remote at another repository, run `git fetch --prune` first. A
# line already on it was checked on its way there, or predates the hook;
# reading it again would refuse every push for what is already published.
#
# WHAT IT DOES NOT ENFORCE, which is the larger half. The rule asks for
# abstraction: a worked case told generically, with no organisation, no
# product, no ticket number, no path off anybody's machine. Whether a passage
# is abstract is a question of meaning, and no pattern answers it. A page that
# names a real employer in plain words passes this hook exactly as a properly
# abstracted one does. Reading for that stays a behaviour rule with nothing
# behind it, and a blocklist of real names would not change that - it would
# only look as though it had.
#
# In the repository's own four-state vocabulary: enforced, for the shapes named
# above and for the identity, and for nothing else.
#
# INSTALL - per clone, and it does not arrive with one:
#     git config core.hooksPath .githooks
#
# DECLARING A SECOND IDENTITY - for a co-author or a fork:
#     git config --add imprint.allowedIdentity 'Name <address>'
# Your own user.name and user.email count as declared without being listed.
#
# BYPASS. `git push --no-verify` skips every hook, silently, and this script
# cannot see that it happened. Setting IMPRINT_PUSH_ANYWAY to a reason is the
# loud alternative: the findings are printed in full, the reason is echoed
# back, and the push proceeds.
#
# NOTHING TO PUSH. Git runs this hook even when every ref is already up to
# date, and then pipes in an empty ref list. That is not a failure to read the
# input: it is git saying that nothing new leaves the machine, so there is
# nothing here to check and the push proceeds. An empty list from something
# that is not git - no remote name and location in the arguments, or a terminal
# on standard input - is a hook that was handed nothing, and is still refused.
#
# NOTHING NEW. A ref whose commits the remote already holds - a new branch at
# a commit already on it, say - adds no commit, and the push proceeds with the
# checks named as skipped.
#
# FAIL-CLOSED. Every other way this script can fail to finish - a git command
# that errors, an unset identity, a temporary file it cannot create or write to
# - ends in a refused push. A gate that waves you through when it breaks is
# worse than no gate, because it is indistinguishable from one that checked.

set -u

# Two settings from the environment would make this script read something other
# than what the push publishes (both measured with git 2.55.0, 2026-10-01):
# GIT_DIFF_OPTS overrides -U0 even on diff-tree, and the context lines it brings
# back can shift the line numbers the merge check matches on; and with
# `git replace`, git shows the replacement wherever an object is read, while a
# push sends the original.
unset GIT_DIFF_OPTS
export GIT_NO_REPLACE_OBJECTS=1

say() { printf '%s\n' "$*" >&2; }
refuse() { say "pre-push: $*"; say "pre-push: refusing the push."; exit 1; }

# note FILE FORMAT [ARG...] - printf FORMAT ARG... onto the end of FILE in the
# working directory. The verdict reads these files, and an empty one means
# clean: a line that could not be written - on a full disk, say - would wave the
# push through with "no findings". So a write that fails refuses the push;
# refuse writes to standard error only, which still works then.
cannot_write="could not write the hook's report; refusing rather than reporting a clean push."
note() {
  nt_file="$1"; shift
  # shellcheck disable=SC2059 # every caller passes its format as a literal
  printf "$@" >>"$work/$nt_file" || refuse "$cannot_write"
}

# Git calls this hook with exactly two parameters - the name and the location of
# the destination remote - and pipes the ref list in. Without them, or with a
# terminal on standard input, whatever is running this is not a push, and an
# empty ref list from it says nothing about what is being published.
if [ "$#" -eq 2 ] && [ ! -t 0 ]; then git_is_calling=yes; else git_is_calling=no; fi

# The destination remote's tracking refs stand for what it already holds - but
# only when git named a remote this clone has configured. A location, or a name
# with no remote behind it here, has no tracking refs to trust, and then every
# commit the remote's old tip does not reach counts as new. A name holding a
# glob character would widen --remotes=, so it is treated the same way: that
# checks more, never less.
#
# And only while that remote is the only one writing there. --remotes=<name>
# reads refs/remotes/<name>/*, and the * crosses a slash: another remote named
# <name>/<more> stores its refs under that prefix by default, and any remote's
# fetch refspec can store them there - +refs/heads/*:refs/remotes/<name>/x/*,
# +refs/heads/x:remotes/<name>/x (git puts refs/ in front of a destination
# without a glob that starts with remotes/), or a mirror's +refs/*:refs/*. A
# commit only that other remote holds would then pass as already on the
# destination, so when another remote's name or fetch refspec reaches under
# refs/remotes/<name>/, none of those refs is trusted.
#
# Two places define remotes that `git remote` and `git config` here do not
# show, and neither is read: a file in the git directory's legacy remotes/
# folder, whose Pull: lines git still fetches by (a push by name to a remote
# that fetches into remotes/<x>/... leaves a plain file there too, which
# `git remote remove` does not delete), and, with
# extensions.worktreeConfig on, another worktree's config.worktree, which can
# add a remote or point this one's fetch elsewhere with url.<base>.insteadOf
# (both measured with git 2.55.0, 2026-10-01). While either is in use, none of
# the tracking refs is trusted. A conditional include (includeIf) that differs
# between worktrees is not covered.
#
# And only when the push goes where those refs were fetched from. With a
# remote.<name>.pushurl, a url.<base>.pushInsteadOf or a second
# remote.<name>.url, git hands this hook a location other than the fetch URL,
# and commits that only the fetch repository holds would pass as published.
# The location has to equal `git remote get-url <name>` - the fetch URL, with
# insteadOf applied, as git applies it - or the tracking refs are not trusted.
# The location itself is never printed: a URL can carry a credential.
#
# shared_by NAME - sets shared to why refs/remotes/NAME/ is not NAME's alone,
# or cannot be told to be, or to nothing when no other remote writes there.
shared_by() {
  sb_dest="$1"; shared=''
  sb_common="$(git rev-parse --git-common-dir 2>/dev/null)" && [ -n "$sb_common" ] \
    || { shared="git rev-parse could not name the git directory"; return; }
  if [ -e "$sb_common/remotes" ]; then
    sb_legacy="$(ls -A "$sb_common/remotes" 2>/dev/null)" \
      || { shared="the git directory's legacy remotes/ folder could not be listed"; return; }
    [ -z "$sb_legacy" ] \
      || { shared="the legacy remotes/ folder in the git directory is not empty, and this hook does not read it"; return; }
  fi
  # extensions is read from the repository's own config file, as git reads it,
  # so that a -c on the command line cannot hide it.
  sb_wtc="$(git config --file "$sb_common/config" --type=bool --get extensions.worktreeConfig 2>/dev/null)"; sb_rc=$?
  [ "$sb_rc" -le 1 ] || { shared="git config could not read extensions.worktreeConfig"; return; }
  [ "$sb_wtc" != true ] \
    || { shared="extensions.worktreeConfig is on, and another worktree's config.worktree can define a remote or turn this one's fetch elsewhere"; return; }
  sb_remotes="$(git remote 2>/dev/null)" || { shared="git remote failed"; return; }
  while IFS= read -r sb_r; do
    [ -n "$sb_r" ] && [ "$sb_r" != "$sb_dest" ] || continue
    case "$sb_r" in
      "$sb_dest"/*) shared="remote $sb_r stores its refs under refs/remotes/$sb_dest/"; return ;;
    esac
    sb_specs="$(git config --get-all "remote.$sb_r.fetch" 2>/dev/null)"; sb_rc=$?
    [ "$sb_rc" -le 1 ] || { shared="git config could not read remote $sb_r's fetch refspecs"; return; }
    while IFS= read -r sb_spec; do
      sb_spec="${sb_spec#+}"
      case "$sb_spec" in '^'* | '') continue ;; *:*) ;; *) continue ;; esac
      sb_dst="${sb_spec#*:}"
      sb_hit=no
      case "$sb_dst" in
        *'*'*)
          sb_pre=${sb_dst%%\**}
          case "refs/remotes/$sb_dest/" in "$sb_pre"*) sb_hit=yes ;; esac
          case "$sb_pre" in "refs/remotes/$sb_dest/"*) sb_hit=yes ;; esac
          ;;
        "refs/remotes/$sb_dest/"* | "remotes/$sb_dest/"*) sb_hit=yes ;;
      esac
      [ "$sb_hit" = no ] || { shared="remote $sb_r fetches into refs/remotes/$sb_dest/"; return; }
    done <<EOF
$sb_specs
EOF
  done <<EOF
$sb_remotes
EOF
}

dest_remote=''
untrusted=''
if [ "$#" -eq 2 ] && [ -n "$1" ]; then
  case "$1" in
    *'*'* | *'?'* | *'['*) ;;
    *)
      if git config --get "remote.$1.url" >/dev/null 2>&1; then
        if fetch_url="$(git remote get-url "$1" 2>/dev/null)"; then
          if [ "$fetch_url" != "$2" ]; then
            untrusted="the push location is not remote $1's fetch URL, so refs/remotes/$1/* are not trusted"
          else
            shared_by "$1"
            if [ -z "$shared" ]; then
              dest_remote="$1"
            else
              untrusted="$shared, so refs/remotes/$1/* are not trusted"
            fi
          fi
        else
          untrusted="git remote get-url $1 failed, so refs/remotes/$1/* are not trusted"
        fi
      fi
      ;;
  esac
fi

work="$(mktemp -d 2>/dev/null)" || refuse "could not create a working directory."
[ -n "$work" ] && [ -d "$work" ] || refuse "mktemp named no working directory."
# A relative TMPDIR makes this a relative path, and awk takes an operand of the
# form name=value for an assignment rather than a file: a TMPDIR of a=b would
# have the merge check read nothing. A path that starts with a slash is a file.
case "$work" in /*) ;; *) work="$PWD/$work" ;; esac
trap 'rm -rf "$work"' EXIT
# dash and busybox sh do not run the EXIT trap when a signal ends them; these
# clean up and still refuse the push.
trap 'rm -rf "$work"; exit 1' HUP INT TERM
# hits, hits.own, hits.c and greperr, which the shape greps write to, are made
# here too: in bash and busybox sh a redirection that fails returns 1, which is
# also grep's "no line matched". Once they exist, grep's > and 2> only truncate
# them, which takes neither space nor an inode. true, not ":" - a redirection
# that fails on a special built-in such as ":" ends the shell before || refuse
# can say why.
for f in findings errors ran skipped ranges hits hits.own hits.c greperr; do
  true >"$work/$f" || refuse "$cannot_write"
done

# --- the identities this clone declares -------------------------------------
me_name="$(git config --get user.name || true)"
me_mail="$(git config --get user.email || true)"
[ -n "$me_name" ] && [ -n "$me_mail" ] || refuse \
  "user.name or user.email is unset here, so this hook cannot tell your own commits from a stranger's."

# --- what is being pushed ----------------------------------------------------
zero="$(git hash-object --stdin </dev/null | sed 's/./0/g')" || refuse "git hash-object failed."
lines=0; n_ranges=0
# The `|| [ -n ... ]` catches a last line with no newline after it, which read
# reports as a failure although it filled the variables. A line that arrives
# but does not parse is refused rather than skipped: after the loop, lines=0
# has to mean that git sent no bytes at all, or an unreadable input would wear
# the face of an up-to-date remote.
while read -r local_ref local_oid remote_ref remote_oid || [ -n "${local_ref:-}" ]; do
  [ -n "${remote_oid:-}" ] || refuse \
    "could not read this as a ref line from git: \"${local_ref:-}\"."
  lines=$((lines + 1))
  if [ "$local_oid" = "$zero" ]; then
    note skipped 'deletion of %s - a deletion carries no new content\n' "$remote_ref"
  else
    printf '%s %s %s\n' "$local_oid" "$remote_oid" "$remote_ref" >>"$work/ranges"
    n_ranges=$((n_ranges + 1))
  fi
done
# A ref line that could not be written down - under a file size limit, say -
# would leave the check unseen, and an empty list reads as nothing to push.
n_written="$(wc -l <"$work/ranges" | tr -d ' ')"
[ "$n_written" = "$n_ranges" ] || refuse \
  "wrote down ${n_written:-no} of $n_ranges ref line(s) to check."
if [ "$lines" -eq 0 ]; then
  [ "$git_is_calling" = yes ] || refuse \
    "no refs on standard input, and nothing says git piped them in; a silent empty run is not a pass."
  note skipped 'every ref - git listed none to push, so nothing is being published\n'
fi

if [ ! -s "$work/ranges" ]; then
  say "pre-push: checks that ran: none needed."
  while read -r s; do say "pre-push:   skipped: $s"; done <"$work/skipped"
  exit 0
fi

# new_commits LOCAL REMOTE - the commits LOCAL brings that the destination does
# not hold yet. One rule for a new ref and an updated one: after a rebase onto a
# newer main and a force-push, main's commits are on the tracking refs and stay
# out. The remote's old tip counts only when this clone has it; without it the
# exclusion is dropped, which checks more, not less.
new_commits() {
  nc_local="$1"; nc_remote="$2"
  set -- "$nc_local" --not
  if [ "$nc_remote" != "$zero" ] && git cat-file -e "$nc_remote^{commit}" 2>/dev/null; then
    set -- "$@" "$nc_remote"
  fi
  [ -z "$dest_remote" ] || set -- "$@" --remotes="$dest_remote"
  git rev-list "$@"
}

# --- what each pushed ref points at ------------------------------------------
# A ref can point at a commit, at an annotated tag, or straight at a blob or a
# tree. rev-list reads only commits: handed a blob, a tree, or a tag that peels
# to either, it lists nothing and succeeds (measured with git 2.55.0,
# 2026-10-01), and the push would pass as one with no new commit. So each local
# oid is typed first, and a tag is peeled one object at a time: every tag object
# on the way is published with the ref and goes to check 4, an inner tag of a
# nested one as much as the outer. A ref that ends in a commit goes on to
# rev-list with that commit. tags lists each tag object once - "oid N ref",
# its content, with any NUL turned into \001, in tag.N; objects lists the
# refs that end in a blob or a tree - "type oid ref via", via being "direct"
# or "tag" - for the finding below.
# An object this clone cannot type or read stops the push here: what a ref
# publishes has to be known before anything about it can be checked.
for f in commitrefs tags objects; do
  true >"$work/$f" || refuse "$cannot_write"
done
n_tags=0
while read -r local_oid remote_oid remote_ref; do
  obj="$local_oid"; via=direct
  type="$(git cat-file -t "$obj" 2>/dev/null </dev/null)" \
    || refuse "could not read the type of $obj, pushed to $remote_ref."
  while [ "$type" = tag ]; do
    via=tag
    if ! grep -q "^$obj " "$work/tags"; then
      n_tags=$((n_tags + 1))
      git cat-file tag "$obj" >"$work/tag.raw" 2>/dev/null </dev/null \
        || refuse "could not read tag object $obj, pushed to $remote_ref."
      # A NUL would end a line early in some seds; it never matches a shape.
      tr '\000' '\001' <"$work/tag.raw" >"$work/tag.$n_tags" \
        || refuse "could not prepare tag object $obj, pushed to $remote_ref, for reading."
      printf '%s %s %s\n' "$obj" "$n_tags" "$remote_ref" >>"$work/tags"
      tagfile="$work/tag.$n_tags"
    else
      tagfile="$work/tag.$(sed -n "s/^$obj \\([0-9]*\\) .*/\\1/p" "$work/tags")"
    fi
    obj="$(sed -n -e '/^$/q' -e 's/^object //p' "$tagfile")"
    case "$obj" in
      '' | *[!0-9a-f]*) refuse "a tag object pushed to $remote_ref names no object it points at." ;;
    esac
    type="$(git cat-file -t "$obj" 2>/dev/null </dev/null)" \
      || refuse "could not read the type of $obj, which a tag pushed to $remote_ref points at."
  done
  case "$type" in
    commit) printf '%s %s\n' "$obj" "$remote_oid" >>"$work/commitrefs" ;;
    blob | tree) printf '%s %s %s %s\n' "$type" "$obj" "$remote_ref" "$via" >>"$work/objects" ;;
    *) refuse "$remote_ref points at a $type, which this hook does not know how to read." ;;
  esac
done <"$work/ranges" || refuse "could not read back the ref list."
# As for the ref list: a line that could not be written down - under a file
# size limit, say - would leave a ref or a tag object unread.
n_sorted=$(( $(wc -l <"$work/commitrefs") + $(wc -l <"$work/objects") ))
n_tags_written="$(wc -l <"$work/tags" | tr -d ' ')"
[ "$n_sorted" = "$n_ranges" ] && [ "$n_tags_written" = "$n_tags" ] || refuse \
  "wrote down $n_sorted of $n_ranges ref(s) and ${n_tags_written:-no} of $n_tags tag object(s) to check."

true >"$work/commits" || refuse "$cannot_write"
while read -r local_oid remote_oid; do
  new_commits "$local_oid" "$remote_oid" >>"$work/commits" </dev/null \
    || refuse "git rev-list failed for $local_oid."
done <"$work/commitrefs" || refuse "could not read back the refs that end in a commit."
sort -u -o "$work/commits" "$work/commits" || refuse "could not sort the commit list."
n_commits="$(wc -l <"$work/commits" | tr -d ' ')"
n_refs="$(wc -l <"$work/ranges" | tr -d ' ')"
if [ -n "$dest_remote" ]; then
  scope="commits already on refs/remotes/$dest_remote/* or at the remote's old tip are not re-checked"
elif [ -n "$untrusted" ]; then
  scope="$untrusted; only commits at the remote's old tip are not re-checked"
else
  scope="no configured remote was named, so only commits at the remote's old tip are not re-checked"
fi

# --- the shapes --------------------------------------------------------------
shapes() {
  cat <<'SHAPES'
address	[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}
phone number	(^|[^0-9])0[0-9]{2,4}[ /-][0-9]{4,}
IBAN	[A-Z]{2}[0-9]{2}( ?[A-Z0-9]{4}){3,}
postcode and place	[0-9]{5}[[:space:]]+[A-ZÄÖÜ][a-zäöüß-]{2,}
SHAPES
}
n_shapes="$(shapes | wc -l | tr -d ' ')"
case "$n_shapes" in '' | 0 | *[!0-9]*) refuse "found no shapes to check." ;; esac
# Every shape loop below reads this file in the main shell, not from a pipe: a
# piped loop runs in a subshell, which has none of the traps above, and a signal
# that ended it alone would leave the remaining shapes unrun while the hook went
# on to report no findings. Each loop counts the shapes it finished, and fewer
# than there are is an error.
shapes >"$work/shapes" || refuse "could not write down the shapes."
n_written="$(wc -l <"$work/shapes" | tr -d ' ')"
[ "$n_written" = "$n_shapes" ] || refuse \
  "wrote down ${n_written:-no} of $n_shapes shape(s)."
tab="$(printf '\t')"

# grep_both NAME PATTERN FILE WHERE - the lines of FILE that match the shape
# NAME, whose pattern is PATTERN, into hits as "N:line", in the order of N.
# Returns 0 when there are any and 1 when there are none. A grep or a merge
# that failed returns 2, and is written to the errors file, naming FILE as
# WHERE.
#
# Each shape is matched twice. Under your own locale, since a pattern holds
# characters outside ASCII; and under C, since a byte that is not valid in your
# locale's encoding matches no bracket expression there - not even [^0-9]. A
# Latin-1 no-break space before a phone number hid it from a UTF-8 locale and
# not from C (measured with GNU grep, 2026-10-01). A line either grep finds is
# a hit, and sort merges the two lists, each line number once.
grep_both() {
  gb_name="$1"; gb_pattern="$2"; gb_file="$3"; gb_where="$4"
  grep -a -n -E "$gb_pattern" "$gb_file" >"$work/hits.own" 2>"$work/greperr" </dev/null
  gb_own=$?
  LC_ALL=C grep -a -n -E "$gb_pattern" "$gb_file" >"$work/hits.c" 2>>"$work/greperr" </dev/null
  gb_c=$?
  if [ "$gb_own" -gt 1 ] || [ "$gb_c" -gt 1 ]; then
    note errors 'grep could not read %s: %s\n' "$gb_where" "$(cat "$work/greperr")"
    return 2
  fi
  # 0 means a line matched, and -n writes at least its number: an empty file
  # is a write that failed, which busybox grep does not report in its exit.
  if { [ "$gb_own" -eq 0 ] && [ ! -s "$work/hits.own" ]; } \
    || { [ "$gb_c" -eq 0 ] && [ ! -s "$work/hits.c" ]; }; then
    note errors 'grep matched %s in %s but wrote no hit down\n' "$gb_name" "$gb_where"
    return 2
  fi
  [ "$gb_own" -eq 0 ] || [ "$gb_c" -eq 0 ] || return 1
  # The merged list holds every line number either grep wrote, so it is at
  # least as long as each of the two; shorter is a write that failed.
  gb_n_own="$(wc -l <"$work/hits.own" | tr -d ' ')"
  gb_n_c="$(wc -l <"$work/hits.c" | tr -d ' ')"
  if ! LC_ALL=C sort -u -t: -k1,1n "$work/hits.own" "$work/hits.c" >"$work/hits" 2>"$work/greperr"; then
    note errors 'sort could not merge the %s hits in %s: %s\n' "$gb_name" "$gb_where" "$(cat "$work/greperr")"
    return 2
  fi
  gb_n="$(wc -l <"$work/hits" | tr -d ' ')"
  [ -n "$gb_n" ] && [ -n "$gb_n_own" ] && [ -n "$gb_n_c" ] \
    && [ "$gb_n" -ge "$gb_n_own" ] && [ "$gb_n" -ge "$gb_n_c" ] && return 0
  note errors 'sort merged %s and %s %s hit(s) in %s into %s\n' \
    "${gb_n_own:-?}" "${gb_n_c:-?}" "$gb_name" "$gb_where" "${gb_n:-?}"
  return 2
}

# The declared identities, written down before the first check that reads
# them: the tagger of a tag is held to them as much as the author of a commit.
printf '%s <%s>\n' "$me_name" "$me_mail" >"$work/allowed" || refuse "$cannot_write"
git config --get-all imprint.allowedIdentity >>"$work/allowed" 2>/dev/null; rc=$?
[ "$rc" -le 1 ] || refuse "git config could not read imprint.allowedIdentity."

# --- annotated tags: the tagger, and the rest of the object -------------------
# A tag object is published with the ref that leads to it, and it carries what
# a commit carries: an identity and a message. The tagger has to be a declared
# identity, as an author has to; GitHub's web-flow identity is let in as the
# committer of a merge and nowhere else. A tag with no tagger names no declared
# identity, and that is a finding. A tagger line that does not end its identity
# in "<...>" is not guessed at: it is a check that could not run.
#
# Everything else in the object is matched against the shapes, line by line:
# the message, a signature block, the tag's name, any other header line, and
# whatever follows the tagger's identity on its line. The header ends at the
# first empty line, as git reads it, and a tag that has none is header to its
# last byte; git then reads no message from it, but the bytes are published all
# the same. A part this hook skipped would be a place to hide a line in. A tag
# object is raw bytes that git does not re-encode, which is why grep_both
# matches it under C as well.
#
# A tag object the remote already holds, pushed again under another name or
# inside a nested tag, is read again: tags have no tracking refs that would say
# what the remote has.
if [ "$n_tags" -gt 0 ]; then
  true >"$work/taggers.undeclared" || refuse "$cannot_write"
  while read -r t_oid t_n t_ref; do
    t_file="$work/tag.$t_n"
    t_name="$(sed -n -e '/^$/q' -e 's/^tag //p' "$t_file" | sed -n 1p)"
    [ -n "$t_name" ] || t_name="$t_oid"
    sed -n -e '/^$/q' -e 's/^tagger //p' "$t_file" >"$work/taggers" || {
      note errors 'sed could not read the tagger of tag %s\n' "$t_name"
      continue
    }
    [ -s "$work/taggers" ] || note findings \
      'no tagger: tag %s names nobody as its tagger, so no declared identity\n' "$t_name"
    # The `|| [ -n ... ]` catches a last line with no newline after it, as on
    # the ref list above: sed keeps a missing final newline as it found it.
    t_line=''
    while IFS= read -r t_line || [ -n "$t_line" ]; do
      t_id="$(printf '%s\n' "$t_line" | sed -n 's/^\(.*>\).*$/\1/p')"
      if [ -z "$t_id" ]; then
        note errors 'could not read the tagger of tag %s as "Name <address>"\n' "$t_name"
      elif ! grep -Fxq -- "$t_id" "$work/allowed"; then
        note findings 'undeclared identity: %s, tagger of tag %s\n' "$t_id" "$t_name"
        note taggers.undeclared '%s\n' "$t_id"
      fi
      t_line=''
    done <"$work/taggers" || refuse "could not read back the tagger of tag $t_name."
    # The object as it is, but for the identity on each tagger line of the
    # header, checked above; line numbers stay those of the object.
    sed -e '/^$/,$b' -e 's/^tagger .*>/tagger/' "$t_file" >"$work/tagtext" || {
      note errors 'sed could not read tag %s\n' "$t_name"
      continue
    }
    n_done=0
    while IFS="$tab" read -r name pattern; do
      if grep_both "$name" "$pattern" "$work/tagtext" "tag $t_name"; then
        while IFS= read -r hit; do
          note findings '%s in tag %s: %s\n' "$name" "$t_name" "$hit"
        done <"$work/hits" || refuse "could not read back the hits in tag $t_name."
      fi
      n_done=$((n_done + 1))
    done <"$work/shapes"
    [ "$n_done" = "$n_shapes" ] || note errors \
      'ran %s of %s shape(s) over tag %s\n' "$n_done" "$n_shapes" "$t_name"
  done <"$work/tags" || refuse "could not read back the tag list."
  n_tag_undeclared="$(sort -u "$work/taggers.undeclared" | wc -l | tr -d ' ')"
  note ran 'annotated tags - the tagger, and %s shape(s) over the rest of the object, for %s tag object(s); %s undeclared tagger(s)\n' \
    "$n_shapes" "$n_tags" "$n_tag_undeclared"
else
  note skipped 'annotated tags - no pushed ref leads to a tag object\n'
fi

# --- refs that end in a blob or a tree ---------------------------------------
# A ref may point straight at a blob or a tree, or at a tag that ends in one.
# A local bare repository took a blob under refs/tags/ and a tree under a
# namespace of its own, and refused a blob under refs/heads/ (measured with
# git 2.55.0, 2026-10-01). Its content is not read here: a blob or a
# tree carries no history to tell new lines from published ones, so every line
# in it would count as new. Such a ref is a finding instead (the owner's call,
# 2026-10-01): IMPRINT_PUSH_ANYWAY with a reason is the loud way to push one on
# purpose.
if [ -s "$work/objects" ]; then
  while read -r o_type o_oid o_ref o_via; do
    if [ "$o_via" = tag ]; then
      note findings 'unread content: the tag pushed to %s ends in %s %s, and this hook does not read a %s\n' \
        "$o_ref" "$o_type" "$o_oid" "$o_type"
    else
      note findings 'unread content: %s points straight at %s %s, and this hook does not read a %s\n' \
        "$o_ref" "$o_type" "$o_oid" "$o_type"
    fi
  done <"$work/objects" || refuse "could not read back the refs that end in a blob or a tree."
  note ran 'refs to a blob or a tree - %s ref(s), each a finding, its content unread\n' \
    "$(wc -l <"$work/objects" | tr -d ' ')"
fi

# report - says what ran, what was skipped and what was found, and ends the
# hook with its verdict. It does not return.
report() {
  say "pre-push: $n_refs ref(s), $n_commits new commit(s), $n_tags tag object(s); $scope."
  say "pre-push: checks that ran:"
  while read -r r; do say "pre-push:   ran: $r"; done <"$work/ran"
  if [ -s "$work/skipped" ]; then
    while read -r s; do say "pre-push:   skipped: $s"; done <"$work/skipped"
  else
    say "pre-push:   skipped: none"
  fi
  say "pre-push:   not checked by anything here: whether the prose is abstract."

  # A check that could not run is not a check that passed, and no override
  # covers it: "I could not look" and "I looked and found nothing" must never
  # share an exit. The verdict reads a missing file as an empty one, so both
  # have to be there.
  [ -f "$work/errors" ] && [ -f "$work/findings" ] || refuse \
    "the files the checks report into are gone, so the checks could not run."
  if [ -s "$work/errors" ]; then
    say ""
    say "pre-push: $(wc -l <"$work/errors" | tr -d ' ') check(s) could not run:"
    while IFS= read -r e; do say "  $e"; done <"$work/errors"
    say "pre-push: this is not a finding and IMPRINT_PUSH_ANYWAY does not cover it."
    refuse "a check could not run."
  fi

  if [ ! -s "$work/findings" ]; then
    say "pre-push: no findings. The shapes are clean; the abstraction is your judgement."
    exit 0
  fi

  say ""
  say "pre-push: $(wc -l <"$work/findings" | tr -d ' ') finding(s):"
  while IFS= read -r f; do say "  $f"; done <"$work/findings"
  say ""
  if [ -n "${IMPRINT_PUSH_ANYWAY:-}" ]; then
    say "pre-push: IMPRINT_PUSH_ANYWAY is set - \"$IMPRINT_PUSH_ANYWAY\" - pushing with the findings above unresolved."
    exit 0
  fi
  say "pre-push: fix them, declare the identity with"
  say "pre-push:   git config --add imprint.allowedIdentity 'Name <address>'"
  say "pre-push: or push anyway with a stated reason:"
  say "pre-push:   IMPRINT_PUSH_ANYWAY='why' git push"
  refuse "$(wc -l <"$work/findings" | tr -d ' ') finding(s) above."
}

# No new commit, so no commit identity, added line or commit message to check.
# This has to come before any `git log --stdin`: handed an empty list, git log
# falls back to HEAD and would check a commit nobody is pushing (measured with
# git 2.55.0, 2026-10-01). With no tag object and no blob or tree either,
# nothing at all was read.
if [ "$n_commits" -eq 0 ]; then
  if [ "$n_tags" -eq 0 ] && [ ! -s "$work/objects" ]; then
    say "pre-push: $n_refs ref(s), 0 new commit(s), 0 tag object(s); $scope."
    say "pre-push: checks that ran: none needed."
    say "pre-push:   skipped: declared identity, tracked content, commit messages - no new commit, so no commit identity, added line or commit message to check"
    while read -r s; do say "pre-push:   skipped: $s"; done <"$work/skipped"
    say "pre-push:   not checked by anything here: whether the prose is abstract."
    exit 0
  fi
  note skipped 'declared identity, tracked content, commit messages - no new commit, so no commit identity, added line or commit message to check\n'
  report
fi

# --- check 1: every author and committer is a declared identity --------------
# A committer may also be GitHub's web-flow identity, which a merge through the
# web UI or API records: the mergeCommitter entry in .imprint/commit.conf. It is
# put together from parts, as there, so this file carries no address-shaped
# literal for its own check to flag. As an author it is still undeclared.
web_flow_name='GitHub'
web_flow_user='noreply'
web_flow_domain='github.com'
at=@
web_flow="$web_flow_name <$web_flow_user$at$web_flow_domain>"
cp "$work/allowed" "$work/committers" || refuse "could not copy the declared identities."
note committers '%s\n' "$web_flow"

# git log re-encodes what it prints into i18n.logOutputEncoding, or into
# i18n.commitEncoding when that is unset (measured with git 2.55.0,
# 2026-10-01). A declared name outside ASCII, printed in Latin-1, would no
# longer equal the UTF-8 one in the declared list, so git is asked for UTF-8,
# which is what git config holds.
git log --no-walk=unsorted --stdin --encoding=UTF-8 --format='A %an <%ae>%nC %cn <%ce>' \
  <"$work/commits" >"$work/ids" || refuse "git log failed reading the identities of the new commits."
sort -u -o "$work/ids" "$work/ids" || refuse "could not sort the identities."
true >"$work/undeclared" || refuse "$cannot_write"
while IFS= read -r line; do
  role="${line%% *}"; id="${line#? }"
  [ -n "$id" ] || continue
  if [ "$role" = C ]; then list="$work/committers"; else list="$work/allowed"; fi
  grep -Fxq -- "$id" "$list" && continue
  note undeclared '%s\n' "$id"
done <"$work/ids" || refuse "could not read back the identities of the new commits."
sort -u -o "$work/undeclared" "$work/undeclared" || refuse "could not sort the undeclared identities."
while IFS= read -r id; do
  note findings 'undeclared identity: %s\n' "$id"
done <"$work/undeclared" || refuse "could not read back the undeclared identities."
undeclared="$(wc -l <"$work/undeclared" | tr -d ' ')"
n_ids="$(sed 's/^. //' "$work/ids" | sort -u | wc -l | tr -d ' ')"
note ran 'declared identity - %s identity/identities over %s new commit(s), %s undeclared\n' \
  "$n_ids" "$n_commits" "$undeclared"

# --- check 2: tracked content, the lines the new commits add -----------------
# Every new commit, not just the tip: a push publishes them all, and a line
# removed in a later commit stays reachable by its hash for anyone who clones.
# The added lines are enough, because every line of a new commit's tree was
# either added by some new commit or is already on the remote.
#
# A merge adds a line only when the line is new against every parent - a line
# from either parent was checked at that parent or is already published. Each
# commit is therefore diffed once per parent (a root commit once, against
# nothing), and a line counts as added only when every one of those diffs adds
# it at the same place: same path, same line number in the commit's own tree,
# same content. All the diffs number lines in that one tree, so the match is
# exact. A combined diff (-c) is not used, because it ignores --text: a file
# that holds a NUL byte in the merge or in any parent, or that .gitattributes
# marks binary, comes out as "Binary files differ" with no line in it (measured
# with git 2.55.0, 2026-10-01). On a plain diff --text is not decoration either
# - without it the same files would read as nothing, which looks exactly like a
# clean diff - and should git print "Binary files" anyway, that is an error.
#
# The awks only sort lines; the shapes are matched by grep below, under your
# own locale and under C (grep_both): a file is stored as it was written, in
# whatever encoding that was. classify turns
# one diff into one record per added line, "commit:path:line<TAB>content" -
# git quotes a path that holds a control character, so the location has no raw
# TAB. Inside a hunk every line starts with +, -, a space or a backslash; any
# other line means the diff is not in the shape these line numbers assume, and
# the commit is not read rather than read wrong. intersect keeps the records
# every parent's diff has and appends them to two parallel files: line N of
# addedloc says where line N of added comes from (commit:path:line), and added
# holds the bare content. Both awks report how many records they wrote, and a
# file that holds fewer - a write that failed without awk saying so - is an
# error, not a shorter list.
classify='
BEGIN { st = 0; c = ENVIRON["IMPRINT_COMMIT"]; errf = ENVIRON["IMPRINT_AWKERR"]; k = 0 }
/^Binary files / {
  p = substr($0, 14); sub(/ differ$/, "", p)
  i = index(p, " and "); if (i) p = substr(p, i + 5)
  if (substr(p, 1, 2) == "b/") p = substr(p, 3)
  print "could not read " p " as text" > errf
  exit 4
}
/^diff / { st = 1; path = ""; next }
st == 1 && /^\+\+\+ / {
  path = substr($0, 5)
  if (substr(path, 1, 2) == "b/") path = substr(path, 3)
  if (substr(path, length(path), 1) == "\t") path = substr(path, 1, length(path) - 1)
  next
}
/^@/ {
  if (substr($0, 1, 3) != "@@ ") exit 3
  split($0, f, " ")
  ln = f[3]
  if (substr(ln, 1, 1) != "+") exit 3
  ln = substr(ln, 2); sub(/,.*/, "", ln)
  if (ln !~ /^[0-9]+$/) exit 3
  ln = ln + 0
  st = 2
  next
}
st == 2 {
  ch = substr($0, 1, 1)
  if (ch == "+") { print c ":" path ":" ln "\t" substr($0, 2); ln++; k++ }
  else if (ch == " ") ln++
  else if (ch != "-" && ch != "\\") exit 3
}
END { print k > ENVIRON["IMPRINT_AWKCNT"] }
'
intersect='
BEGIN { n = ARGC - 1; loc = ENVIRON["IMPRINT_ADDEDLOC"]; add = ENVIRON["IMPRINT_ADDED"]; fi = 0; m = 0 }
FNR == 1 { fi++ }
{
  if ((fi, $0) in seen) next
  seen[fi, $0] = 1
  cnt[$0]++
  if (fi == 1) order[++m] = $0
}
END {
  k = 0
  for (i = 1; i <= m; i++) {
    r = order[i]
    if (cnt[r] != n) continue
    t = index(r, "\t")
    if (t < 2) exit 3
    print substr(r, 1, t - 1) >> loc
    print substr(r, t + 1) >> add
    k++
  }
  print k
}
'
# join puts a grep hit back where it came from: "N:content" becomes
# "shape: commit:path:line:content", the form git grep prints.
join='
BEGIN {
  f = ENVIRON["IMPRINT_ADDEDLOC"]; name = ENVIRON["IMPRINT_SHAPE"]; n = 0
  while ((r = (getline l < f)) > 0) loc[++n] = l
  if (r < 0) exit 2
}
{
  i = index($0, ":")
  k = substr($0, 1, i - 1)
  if (i < 2 || !(k in loc)) exit 3
  print name ": " loc[k] ":" substr($0, i + 1)
}
'

# read_added BASE COMMIT OUT - the records of the lines COMMIT adds against
# BASE, or against nothing when BASE is empty, into OUT. Any step that fails
# goes to the errors file, and the caller drops the commit's records.
read_added() {
  ra_base="$1"; ra_commit="$2"; ra_out="$3"
  if [ -n "$ra_base" ]; then
    ra_against="$ra_base"
    git -c diff.suppressBlankEmpty=false \
      diff-tree --no-commit-id -r -p -M -U0 --text --no-ext-diff --no-textconv --no-color \
      "$ra_base" "$ra_commit" >"$work/diff" 2>"$work/differr" </dev/null
  else
    ra_against="nothing (a root commit)"
    git -c diff.suppressBlankEmpty=false \
      diff-tree --no-commit-id -r -p -M -U0 --text --no-ext-diff --no-textconv --no-color \
      --root "$ra_commit" >"$work/diff" 2>"$work/differr" </dev/null
  fi || {
    note errors 'git diff-tree could not read %s against %s: %s\n' \
      "$ra_commit" "$ra_against" "$(cat "$work/differr")"
    return 1
  }
  # A NUL would end an awk record early in some awks; it never matches a shape.
  tr '\000' '\001' <"$work/diff" >"$work/diff.t" || {
    note errors 'tr could not prepare the diff of %s against %s\n' "$ra_commit" "$ra_against"
    return 1
  }
  true >"$work/awkerr" && true >"$work/awkcnt" || refuse "$cannot_write"
  IMPRINT_COMMIT="$ra_commit" IMPRINT_AWKERR="$work/awkerr" IMPRINT_AWKCNT="$work/awkcnt" \
    LC_ALL=C awk "$classify" <"$work/diff.t" >"$ra_out" || {
    note errors 'awk could not sort the diff of %s against %s into added lines: %s\n' \
      "$ra_commit" "$ra_against" "$(cat "$work/awkerr")"
    return 1
  }
  ra_k="$(cat "$work/awkcnt")"; ra_n="$(wc -l <"$ra_out" | tr -d ' ')"
  [ -n "$ra_k" ] && [ "$ra_k" = "$ra_n" ] || {
    note errors 'wrote down %s of %s line(s) %s adds against %s\n' \
      "$ra_n" "${ra_k:-an unknown number of}" "$ra_commit" "$ra_against"
    return 1
  }
}

# intersect_added N - appends to added and addedloc the records that all of
# rec.1 .. rec.N hold, and prints how many.
intersect_added() {
  ia_n="$1"; ia_i=1
  set --
  while [ "$ia_i" -le "$ia_n" ]; do set -- "$@" "$work/rec.$ia_i"; ia_i=$((ia_i + 1)); done
  IMPRINT_ADDED="$work/added" IMPRINT_ADDEDLOC="$work/addedloc" \
    LC_ALL=C awk "$intersect" "$@" </dev/null
}

true >"$work/added" && true >"$work/addedloc" || refuse "$cannot_write"
n_added=0
# One line per new commit: the commit, then its parents.
if git rev-list --no-walk=unsorted --parents --stdin <"$work/commits" >"$work/parents" 2>"$work/rlerr"; then
  n_parents_lines="$(wc -l <"$work/parents" | tr -d ' ')"
  [ "$n_parents_lines" = "$n_commits" ] || note errors \
    'git rev-list listed parents for %s of %s new commit(s)\n' "$n_parents_lines" "$n_commits"
else
  note errors 'git rev-list could not read the parents of the new commits: %s\n' "$(cat "$work/rlerr")"
  true >"$work/parents" || refuse "$cannot_write"
fi
while read -r commit parents; do
  [ -n "$commit" ] || continue
  n=0; ok=yes
  if [ -z "$parents" ]; then
    n=1
    read_added '' "$commit" "$work/rec.1" || ok=no
  else
    for parent in $parents; do
      n=$((n + 1))
      read_added "$parent" "$commit" "$work/rec.$n" || { ok=no; break; }
    done
  fi
  [ "$ok" = yes ] || continue
  if k="$(intersect_added "$n")"; then
    case "$k" in
      '' | *[!0-9]*) note errors 'awk reported no count of the added lines of %s\n' "$commit" ;;
      *) n_added=$((n_added + k)) ;;
    esac
  else
    note errors 'awk could not match the added lines of %s across its %s parent(s)\n' "$commit" "$n"
  fi
done <"$work/parents" || refuse "could not read back the parents of the new commits."
for f in added addedloc; do
  n_f="$(wc -l <"$work/$f" | tr -d ' ')"
  [ "$n_f" = "$n_added" ] || note errors \
    'wrote down %s of %s added line(s) in %s\n' "${n_f:-none}" "$n_added" "$f"
done
n_done=0
while IFS="$tab" read -r name pattern; do
  if grep_both "$name" "$pattern" "$work/added" "the added lines"; then
    # Every hit is one finding, so findings has to grow by as many lines as
    # hits holds: an awk that lost a write without saying so is an error.
    n_hits="$(wc -l <"$work/hits" | tr -d ' ')"
    n_before="$(wc -l <"$work/findings" | tr -d ' ')"
    if IMPRINT_SHAPE="$name" IMPRINT_ADDEDLOC="$work/addedloc" \
      LC_ALL=C awk "$join" <"$work/hits" >>"$work/findings"; then
      n_after="$(wc -l <"$work/findings" | tr -d ' ')"
      [ -n "$n_hits" ] && [ -n "$n_before" ] && [ "$n_after" = $((n_before + n_hits)) ] \
        || note errors 'findings went from %s to %s line(s) for %s %s hit(s)\n' \
          "${n_before:-?}" "${n_after:-?}" "${n_hits:-?}" "$name"
    else
      note errors 'awk could not place the %s hits\n' "$name"
    fi
  fi
  n_done=$((n_done + 1))
done <"$work/shapes"
[ "$n_done" = "$n_shapes" ] || note errors \
  'ran %s of %s shape(s) over the added lines\n' "$n_done" "$n_shapes"
note ran 'tracked content - %s shape(s) over the lines %s new commit(s) add\n' \
  "$n_shapes" "$n_commits"

# --- check 3: commit messages ------------------------------------------------
# A message is as public as a blob, and trailers are where addresses ride in.
# --encoding=UTF-8 for the reason check 1 gives: in Latin-1, a place that
# starts with an umlaut matches the pattern under neither locale. A message
# whose bytes are not valid UTF-8 and that carries no encoding header to say
# what they are is printed as it is, which grep_both matches under C as well.
git log --no-walk=unsorted --stdin --encoding=UTF-8 --format='%h|%s%n%b' \
  <"$work/commits" >"$work/messages" \
  || refuse "git log failed reading the messages of the new commits."
n_done=0
while IFS="$tab" read -r name pattern; do
  if grep_both "$name" "$pattern" "$work/messages" "the commit messages"; then
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      note findings '%s in a commit message: %s\n' "$name" "$hit"
    done <"$work/hits" || refuse "could not read back the hits in the commit messages."
  fi
  n_done=$((n_done + 1))
done <"$work/shapes"
[ "$n_done" = "$n_shapes" ] || note errors \
  'ran %s of %s shape(s) over the commit messages\n' "$n_done" "$n_shapes"
note ran 'commit messages - %s shape(s) over %s new commit(s)\n' "$n_shapes" "$n_commits"

# --- report ------------------------------------------------------------------
report
